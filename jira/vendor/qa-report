#!/usr/bin/env node
/*
 * VENDORED COPY - not the authoritative one.
 *
 * This is execute-jira-ticket's `scripts/qa-report`, copied into the Jira
 * extension so a batch still produces a report on a machine where that skill
 * is not installed. When it IS installed, the extension runs the user's own
 * copy instead and this file is never touched - so improvements made there
 * reach batch runs without anyone syncing anything.
 *
 * Do not fix bugs here first. Fix them in the skill and re-copy, or the two
 * drift and the fallback quietly becomes the odd one out.
 */

'use strict';
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const die = (m, code = 1) => { console.error(`qa-report: ${m}`); process.exit(code); };
const sh = (cmd) => { try { return execSync(cmd, { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { return ''; } };

// ---------------------------------------------------------------- arguments
const argv = process.argv.slice(2);
if (!argv.length || argv[0] === '-h' || argv[0] === '--help') {
  console.log(fs.readFileSync(__filename, 'utf8').split('\n').slice(2, 40)
    .map(l => l.replace(/^ \* ?/, '').replace(/^ \*\/$/, '')).join('\n'));
  process.exit(2);
}
const specArg = argv[0];
const useAssets = argv.includes('--assets');
const outIdx = argv.indexOf('--out');
const outNameOverride = outIdx > -1 ? argv[outIdx + 1] : null;

// ---------------------------------------------------------------- load spec
let raw;
try {
  raw = specArg === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(specArg, 'utf8');
} catch (e) { die(`cannot read spec: ${e.message}`, 2); }

let spec;
try { spec = JSON.parse(raw); } catch (e) { die(`spec is not valid JSON: ${e.message}`, 2); }
if (!Array.isArray(spec.tickets) || !spec.tickets.length) die('spec.tickets must be a non-empty array', 2);

// ------------------------------------------------------------ resolve paths
if (!sh('git rev-parse --git-dir')) die('not inside a git repository');
// Reports collect in the PRIMARY worktree so every branch's QA lands in one
// place, regardless of which worktree ran it.
const primary = sh('git worktree list --porcelain').split('\n')
  .find(l => l.startsWith('worktree '))?.slice(9) || sh('git rev-parse --show-toplevel');
const outDir = process.env.QA_REPORT_DIR || path.join(primary, '.backups');
fs.mkdirSync(outDir, { recursive: true });

const ids = spec.tickets.map(t => t.id).filter(Boolean);
const slug = spec.slug || (ids.length === 1
  ? `${ids[0].toLowerCase()}-qa`
  : `${(ids[0] || 'qa').split('-')[0].toLowerCase()}-qa-${ids.length}-tickets`);
const stamp = new Date().toISOString().slice(0, 10);
const outName = outNameOverride || `${slug}-${stamp}.html`;
const outPath = path.join(outDir, outName);
const assetDir = path.join(outDir, outName.replace(/\.html$/, '') + '-images');

// --------------------------------------------------------------- environment
const env = Object.assign({
  branch: sh('git rev-parse --abbrev-ref HEAD') || '?',
  commit: sh('git rev-parse --short HEAD') || '?',
  worktree: sh('git rev-parse --show-toplevel') || '?',
  date: new Date().toISOString().slice(0, 16).replace('T', ' '),
}, spec.environment || {});

// ------------------------------------------------------------------- images
const MIME = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
  '.webp': 'image/webp', '.gif': 'image/gif', '.svg': 'image/svg+xml', '.avif': 'image/avif' };

const missing = [];
let inlinedBytes = 0;
if (useAssets) fs.mkdirSync(assetDir, { recursive: true });

// The pixel size, read from the header of the bytes already in hand.
//
// A reviewer cannot judge a screenshot without it: "the header is 4px out" is
// a different claim at 390px than at 2560px, and a report that scales every
// shot to the width of its column hides exactly which one they are looking
// at. Parsed here rather than measured in the browser so it is in the HTML
// for anyone reading the file as text, and so a printed report still carries
// it.
//
// Unknown is a fine answer: SVG has no intrinsic pixel size worth quoting,
// and a format this cannot read simply goes without the label.
const dimensions = (buf, ext) => {
  try {
    if (ext === '.png' && buf.length > 24 && buf.toString('ascii', 12, 16) === 'IHDR') {
      return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) };
    }
    if (ext === '.gif' && buf.length > 10) {
      return { w: buf.readUInt16LE(6), h: buf.readUInt16LE(8) };
    }
    if (ext === '.jpg' || ext === '.jpeg') {
      // Walk the segment chain to the first frame header; the dimensions are
      // not at a fixed offset, and EXIF thumbnails sit before them.
      let i = 2;
      while (i + 9 < buf.length && buf[i] === 0xff) {
        const marker = buf[i + 1];
        const len = buf.readUInt16BE(i + 2);
        // SOF0-SOF15, minus the four that are not frame headers.
        if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
          return { h: buf.readUInt16BE(i + 5), w: buf.readUInt16BE(i + 7) };
        }
        i += 2 + len;
      }
      return null;
    }
    if (ext === '.webp' && buf.length > 30 && buf.toString('ascii', 8, 12) === 'WEBP') {
      const kind = buf.toString('ascii', 12, 16);
      // Lossy: 14 bits each, after the 3-byte start code.
      if (kind === 'VP8 ') return { w: buf.readUInt16LE(26) & 0x3fff, h: buf.readUInt16LE(28) & 0x3fff };
      // Lossless: 14 bits each, packed across four bytes, and one less than
      // the real size.
      if (kind === 'VP8L') {
        const bits = buf.readUInt32LE(21);
        return { w: (bits & 0x3fff) + 1, h: ((bits >> 14) & 0x3fff) + 1 };
      }
      // Extended: 24 bits each, also one less than the real size.
      if (kind === 'VP8X') {
        const at = (o) => buf[o] | (buf[o + 1] << 8) | (buf[o + 2] << 16);
        return { w: at(24) + 1, h: at(27) + 1 };
      }
    }
  } catch { /* a truncated or malformed header is simply unknown */ }
  return null;
};

const resolveImage = (p, ticketId, i) => {
  const abs = path.isAbsolute(p) ? p : path.resolve(process.cwd(), p);
  if (!fs.existsSync(abs)) { missing.push(`${ticketId}: ${p}`); return null; }
  const ext = path.extname(abs).toLowerCase();
  const mime = MIME[ext];
  if (!mime) { missing.push(`${ticketId}: unsupported image type ${ext} (${p})`); return null; }
  const buf = fs.readFileSync(abs);
  const size = dimensions(buf, ext);
  const bytes = buf.length;
  if (useAssets) {
    const name = `${ticketId.toLowerCase()}-${i + 1}${ext}`;
    fs.writeFileSync(path.join(assetDir, name), buf);
    return { src: `${path.basename(assetDir)}/${name}`, size, bytes };
  }
  inlinedBytes += buf.length;
  return { src: `data:${mime};base64,${buf.toString('base64')}`, size, bytes };
};

// Resolve everything up front so a missing file fails before any output.
for (const t of spec.tickets) {
  t._evidence = (t.evidence || []).map((e, i) => {
    const got = resolveImage(e.image, t.id || 'ticket', i);
    return got ? { ...e, src: got.src, size: got.size, bytes: got.bytes } : { ...e, src: null };
  }).filter(e => e.src);
}
if (missing.length) {
  die(`referenced screenshots not found — nothing written:\n  ${missing.join('\n  ')}`, 2);
}

// --------------------------------------------------------------------- HTML
const esc = s => String(s == null ? '' : s)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const STATUS = {
  pass:    { label: 'PASS',    cls: 'pass' },
  fail:    { label: 'FAIL',    cls: 'fail' },
  partial: { label: 'PARTIAL', cls: 'partial' },
  blocked: { label: 'BLOCKED', cls: 'blocked' },
};
const statusOf = t => STATUS[(t.status || '').toLowerCase()] || { label: 'UNVERIFIED', cls: 'unknown' };

const counts = spec.tickets.reduce((a, t) => {
  const k = statusOf(t).cls; a[k] = (a[k] || 0) + 1; return a;
}, {});

// Filter chips only earn their place once there's something to filter —
// one shared tag (or none at all) renders no differently than before.
const tags = [...new Set(spec.tickets.map(t => t.tag).filter(Boolean))];
const showFilters = tags.length > 1;

// problem/fix accept a string or a list — a fix is often more than one change.
const asList = v => Array.isArray(v) ? v.filter(Boolean) : (v ? [v] : []);

// A URL in a step or a note is only useful if the reader can open it. Linkify
// AFTER escaping, so the text is still escaped exactly as before and the href
// carries the already-escaped form (&amp; is what a browser wants anyway).
// Trailing sentence punctuation is left outside the link.
const linkify = escaped => escaped.replace(
  /https?:\/\/[^\s<>"']+/g,
  m => {
    const trail = m.match(/(?:&amp;|[.,;:!?)\]])+$/);
    const href = trail ? m.slice(0, -trail[0].length) : m;
    if (!href) return m;
    return `<a href="${href}" target="_blank" rel="noopener noreferrer">${href}</a>${trail ? trail[0] : ''}`;
  },
);
const rich = v => linkify(esc(v));

const prose = items => items.length === 1
  ? `<p>${rich(items[0])}</p>`
  : `<ul>${items.map(x => `<li>${rich(x)}</li>`).join('')}</ul>`;

// notes take a string or a list too — bullets whenever there is more than one.
const noteHtml = t => {
  const n = asList(t.notes);
  if (!n.length) return '';
  return `<div class="note"><h4>Note${n.length > 1 ? 's' : ''}</h4>${prose(n)}</div>`;
};

const problemFixHtml = t => {
  const p = asList(t.problem), f = asList(t.fix);
  if (!p.length && !f.length) return '';
  const box = (cls, label, items) =>
    `<div class="pf-box ${cls}"><h4>${label}</h4>${prose(items)}</div>`;
  return `<div class="pf${p.length && f.length ? '' : ' pf-one'}">
      ${p.length ? box('problem', 'Problem', p) : ''}
      ${f.length ? box('fix', 'Fix', f) : ''}
    </div>`;
};

const ticketHtml = t => {
  const s = statusOf(t);
  const steps = (t.steps || []).map(x => `<li>${rich(x)}</li>`).join('\n');
  const files = (t.files || []).map(f => `<code>${esc(f)}</code>`).join(' ');
  const shots = t._evidence.map(e => {
    const dim = e.size ? `${e.size.w} × ${e.size.h}` : '';
    const kb = e.bytes ? `${Math.max(1, Math.round(e.bytes / 1024))} KB` : '';
    const meta = [dim, kb].filter(Boolean).join(' · ');
    return `
      <figure class="shot">
        <img src="${e.src}" alt="${esc(e.caption || t.id)}" loading="lazy"
             ${e.size ? `width="${e.size.w}" height="${e.size.h}"` : ''}
             data-caption="${esc([t.id, e.label, e.caption].filter(Boolean).join(' · '))}">
        <figcaption>
          <span class="cap-text">${e.label ? `<span class="tag">${esc(e.label)}</span>` : ''}${esc(e.caption || '')}</span>
          ${meta ? `<span class="cap-dim" title="Full size of the captured image">${esc(meta)}</span>` : ''}
        </figcaption>
      </figure>`;
  }).join('\n');

  return `
  <section class="ticket" id="${esc(t.id)}" data-tag="${esc(t.tag || '')}">
    <header class="t-head">
      <span class="pill ${s.cls}">${s.label}</span>
      ${t.tag ? `<span class="tag-chip">${esc(t.tag)}</span>` : ''}
      <h2>${t.url ? `<a href="${esc(t.url)}">${esc(t.id)}</a>` : esc(t.id)} — ${esc(t.title || '')}</h2>
    </header>
    ${t.summary ? `<p class="summary">${esc(t.summary)}</p>` : ''}
    ${problemFixHtml(t)}
    ${steps ? `<div class="block"><h3>How to QA</h3><ol class="steps">${steps}</ol></div>` : ''}
    ${shots ? `<div class="block"><h3>Evidence</h3><div class="shots">${shots}</div></div>` : ''}
    ${files ? `<div class="block"><h3>Files changed</h3><p class="files">${files}</p></div>` : ''}
    ${noteHtml(t)}
  </section>`;
};

