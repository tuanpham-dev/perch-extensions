.note li:last-child{margin-bottom:0}
.note strong{color:var(--text)}
footer{margin-top:38px;padding-top:15px;border-top:1px solid var(--border);font-size:12px;color:var(--faint)}
</style>
</head>
<body>
<div class="wrap">
<h1>${esc(spec.title || `${ids.join(', ')} — QA Report`)}</h1>
<p class="meta">
  ${spec.tickets.length} ticket${spec.tickets.length === 1 ? '' : 's'} ·
  branch <code>${esc(env.branch)}</code> at <code>${esc(env.commit)}</code>
  ${spec.preview_url ? ` · previewed on <code>${linkify(esc(spec.preview_url))}</code>` : ''}<br>
  Worktree <code>${esc(env.worktree)}</code> · ${esc(env.date)}
  ${env.server ? `<br>Dev server: ${esc(env.server)}` : ''}
</p>

${showFilters ? `<div class="filters" id="qa-filters">
  <button class="filter-chip active" data-filter-tag="">All (${spec.tickets.length})</button>
  ${tags.map(tag => {
    const n = spec.tickets.filter(t => t.tag === tag).length;
    return `<button class="filter-chip" data-filter-tag="${esc(tag)}">${esc(tag)} (${n})</button>`;
  }).join('\n  ')}
</div>` : ''}

<div class="tiles" id="qa-tiles">
  <div class="tile" data-tile="total"><div class="n">${spec.tickets.length}</div><div class="l">Tickets</div></div>
  ${Object.entries(counts).map(([k, n]) =>
    `<div class="tile ${k}" data-tile="${k}"><div class="n">${n}</div><div class="l">${(STATUS[k] || { label: 'Unverified' }).label}</div></div>`).join('\n  ')}
</div>

${spec.tickets.map(ticketHtml).join('\n')}

<footer>
  Generated by <code>qa-report</code> from ${esc(env.worktree)}.
  ${useAssets ? `Screenshots in <code>${esc(path.basename(assetDir))}/</code>.`
              : 'Screenshots are inlined — this file is self-contained and can be attached to a ticket.'}
  Click any screenshot to open it full-screen; scroll or press <code>Z</code> to zoom to actual pixels.
</footer>
</div>

<div class="lb" id="lb" hidden tabindex="-1" role="dialog" aria-modal="true" aria-label="Screenshot viewer">
  <div class="lb-stage" id="lb-stage"><img id="lb-img" alt=""></div>
  <button class="lb-close" id="lb-close" aria-label="Close (Esc)">Close &times;</button>
  <button class="lb-nav lb-prev" id="lb-prev" aria-label="Previous screenshot">&#8249;</button>
  <button class="lb-nav lb-next" id="lb-next" aria-label="Next screenshot">&#8250;</button>
  <div class="lb-bar">
    <span class="lb-cap" id="lb-cap"></span>
    <span class="lb-count" id="lb-count"></span>
    <button id="lb-out" aria-label="Zoom out">&minus;</button>
    <button id="lb-in" aria-label="Zoom in">+</button>
    <button id="lb-actual" aria-label="Toggle actual size">1:1</button>
    <button id="lb-fit" aria-label="Fit to screen">Fit</button>
    <span class="lb-hint">scroll = zoom &middot; drag = pan &middot; Z = 1:1 &middot; &larr;/&rarr; &middot; Esc</span>
  </div>
</div>

<script>
(function () {
  var filters = document.getElementById('qa-filters');
  if (!filters) return;
  var tickets = [].slice.call(document.querySelectorAll('.ticket'));
  var tiles = document.getElementById('qa-tiles');

  filters.addEventListener('click', function (e) {
    var btn = e.target.closest('.filter-chip');
    if (!btn) return;
    [].slice.call(filters.querySelectorAll('.filter-chip')).forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var tag = btn.getAttribute('data-filter-tag');
    var visible = tickets.filter(function (t) {
      var match = !tag || t.getAttribute('data-tag') === tag;
      t.hidden = !match;
      return match;
    });
    if (tiles) {
      var counts = { total: visible.length };
      visible.forEach(function (t) {
        var pill = t.querySelector('.pill');
        var cls = pill ? pill.className.replace('pill', '').trim() : 'unknown';
        counts[cls] = (counts[cls] || 0) + 1;
      });
      [].slice.call(tiles.querySelectorAll('[data-tile]')).forEach(function (tile) {
        var key = tile.getAttribute('data-tile');
        var n = tile.querySelector('.n');
        if (n) n.textContent = counts[key] || 0;
      });
    }
  });
})();

(function () {
  var thumbs = [].slice.call(document.querySelectorAll('figure.shot img'));
  if (!thumbs.length) return;

  var lb = document.getElementById('lb'),
      stage = document.getElementById('lb-stage'),
      img = document.getElementById('lb-img'),
      cap = document.getElementById('lb-cap'),
      cnt = document.getElementById('lb-count');

  var idx = 0, scale = 1, fitScale = 1, tx = 0, ty = 0;
  var dragging = false, moved = false, px = 0, py = 0, lastFocus = null;

  function apply() {
    img.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
    lb.setAttribute('data-zoomed', scale > fitScale * 1.02 ? 'true' : 'false');
  }

  // Fit the whole shot in view first — full-page captures are tall, and the
  // overview is what you want before drilling into pixels.
  function fit() {
    var vw = stage.clientWidth * 0.98, vh = stage.clientHeight * 0.98;
    var nw = img.naturalWidth || 1, nh = img.naturalHeight || 1;
    img.style.width = nw + 'px';
    img.style.height = nh + 'px';
    fitScale = Math.min(vw / nw, vh / nh, 1);
    scale = fitScale; tx = 0; ty = 0; apply();
  }

  function actual() { scale = 1; tx = 0; ty = 0; apply(); }

  function show(n) {
    idx = (n + thumbs.length) % thumbs.length;
    var t = thumbs[idx];
    img.src = t.currentSrc || t.src;
    img.alt = t.alt || '';
    cap.textContent = t.getAttribute('data-caption') || t.alt || '';
    cnt.textContent = (idx + 1) + ' / ' + thumbs.length;
    if (img.complete && img.naturalWidth) fit(); else img.onload = fit;
  }

  function open(n) {
    lastFocus = document.activeElement;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    show(n);
    lb.focus();
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  // Zoom about the pointer so the detail under the cursor stays put.
  function zoomAt(factor, cx, cy) {
    var r = img.getBoundingClientRect();
    var ox = cx - (r.left + r.width / 2);
    var oy = cy - (r.top + r.height / 2);
    var ns = Math.min(Math.max(scale * factor, fitScale * 0.5), 8);
    var k = ns / scale;
    tx -= ox * (k - 1);
    ty -= oy * (k - 1);
    scale = ns;
    apply();
  }

  thumbs.forEach(function (t, n) {
    t.setAttribute('tabindex', '0');
    t.setAttribute('role', 'button');
    t.addEventListener('click', function () { open(n); });
    t.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(n); }
    });
  });

  document.getElementById('lb-close').addEventListener('click', close);
  document.getElementById('lb-prev').addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
  document.getElementById('lb-next').addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });
  document.getElementById('lb-in').addEventListener('click', function () { zoomAt(1.4, innerWidth / 2, innerHeight / 2); });
  document.getElementById('lb-out').addEventListener('click', function () { zoomAt(1 / 1.4, innerWidth / 2, innerHeight / 2); });
  document.getElementById('lb-actual').addEventListener('click', actual);
  document.getElementById('lb-fit').addEventListener('click', fit);

  stage.addEventListener('wheel', function (e) {
    e.preventDefault();
    zoomAt(e.deltaY < 0 ? 1.12 : 1 / 1.12, e.clientX, e.clientY);
  }, { passive: false });

  stage.addEventListener('pointerdown', function (e) {
    dragging = true; moved = false; px = e.clientX; py = e.clientY;
    stage.classList.add('dragging');
    stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    var dx = e.clientX - px, dy = e.clientY - py;
    if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
    tx += dx; ty += dy; px = e.clientX; py = e.clientY;
    apply();
  });
  function endDrag() { dragging = false; stage.classList.remove('dragging'); }
  stage.addEventListener('pointerup', endDrag);
  stage.addEventListener('pointercancel', endDrag);

  // A click that didn't pan: toggle between fit and 1:1.
  stage.addEventListener('click', function (e) {
    if (moved) return;
    if (e.target !== img) { close(); return; }
    if (scale > fitScale * 1.02) fit(); else zoomAt(1 / scale, e.clientX, e.clientY);
  });

  document.addEventListener('keydown', function (e) {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') show(idx + 1);
    else if (e.key === 'ArrowLeft') show(idx - 1);
    else if (e.key === 'z' || e.key === 'Z') { if (scale > fitScale * 1.02) fit(); else actual(); }
    else if (e.key === '+' || e.key === '=') zoomAt(1.4, innerWidth / 2, innerHeight / 2);
    else if (e.key === '-') zoomAt(1 / 1.4, innerWidth / 2, innerHeight / 2);
    else if (e.key === '0') fit();
  });

  addEventListener('resize', function () { if (!lb.hidden) fit(); });
})();
</script>
</body>
</html>
`;

fs.writeFileSync(outPath, html);

const kb = Math.round(fs.statSync(outPath).size / 1024);
console.log(`qa-report: wrote ${outPath}`);
console.log(`  tickets    : ${spec.tickets.map(t => `${t.id}=${statusOf(t).label}`).join(', ')}`);
console.log(`  screenshots: ${spec.tickets.reduce((a, t) => a + t._evidence.length, 0)}`);
console.log(`  size       : ${kb} KB${useAssets ? '' : ' (images inlined)'}`);
if (!useAssets && kb > 10240) {
  console.log('  note       : over 10 MB — consider --assets to keep images external.');
}
